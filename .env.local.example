# Copy the values you need into an untracked .env.local; keep existing settings.
APP_ENV=dev
APP_DEBUG=1
# Generate your own value: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=replace_with_your_own_random_secret
# Default SQL Server instance, Windows Authentication:
DATABASE_URL="mssql://localhost/BanSachDB"
