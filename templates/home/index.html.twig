{% extends 'account/layout.html.twig' %}

{% block title %}Website bán sách · Nhóm 04 – DA23TTA{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/team.css') }}">
{% endblock %}

{% block content %}
    <section class="hero public-hero">
        <div class="hero-copy">
            <p class="eyebrow">CHÀO MỪNG ĐẾN NHÀ SÁCH NHÓM 04</p>

            <h1>Những trang sách.<br>Vô vàn cảm hứng.</h1>

            <p>
                Nơi mỗi hành trình đọc đều bắt đầu bằng sự tò mò.
                Mở không gian tài khoản của bạn ngay hôm nay.
            </p>

            <div class="hero-actions">
                    <a class="button"
                       href="{{ is_admin ? '#book-preview' : path('app_catalog') }}">
                        Khám phá sách →
                    </a>
            </div>
        </div>

        <div class="book-illustration" aria-hidden="true">
            <span class="book book-one">KHÁM PHÁ</span>
            <span class="book book-two">TRI THỨC</span>
            <span class="book book-three">CẢM HỨNG</span>
            <div class="book-shelf"></div>
            <span class="art-caption">YOUR NEXT CHAPTER</span>
        </div>
    </section>

    <section id="book-preview" class="welcome-note">
        <span class="feature-icon" aria-hidden="true">▤</span>
        <div>
            <h2>Một không gian dành cho người yêu sách</h2>
            <p>
                Tìm sách, chọn số lượng và gửi giỏ hàng.
                Theo dõi lịch sử giỏ đã gửi và quản lý hồ sơ trong tài khoản của bạn.
            </p>
        </div>
    </section>
    <section id="nhom-thuc-hien" class="project-team" aria-labelledby="team-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">NHÓM 04 · LỚP DA23TTA</p>
                <h2 id="team-heading">Nhóm thực hiện</h2>
            </div>
            <p>Đề tài: Website bán sách · CRUD Giỏ hàng</p>
        </div>

        {% set members = [
            {name: 'Huỳnh Dương Tấn Phát', student_id: '110123038', role: 'Trưởng nhóm'},
            {name: 'Trần Hoàng Oanh', student_id: '110123037', role: 'Thành viên'},
            {name: 'Cao Á Châu', student_id: '110123206', role: 'Thành viên'},
            {name: 'Trần Vũ Ngọc Huỳnh', student_id: '110123012', role: 'Thành viên'},
            {name: 'Võ Thị Kiều Nhi', student_id: '110123033', role: 'Thành viên'},
            {name: 'Nguyễn An Ninh', student_id: '110123036', role: 'Thành viên'},
            {name: 'Phạm Bá Hạo Long', student_id: '110123024', role: 'Thư ký'}
        ] %}

        <ul class="team-list">
            {% for member in members %}
                <li class="team-member">
                    <p class="team-member-role">{{ member.role }}</p>
                    <h3>{{ member.name }}</h3>
                    <p class="team-member-id">MSSV: {{ member.student_id }}</p>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endblock %}
