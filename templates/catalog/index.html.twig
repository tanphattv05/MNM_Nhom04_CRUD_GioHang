{% extends 'account/layout.html.twig' %}
{% block title %}Danh mục sách · Nhà sách Nhóm 04{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('styles/shop.css') }}">{% endblock %}
{% block content %}{% set cartErrors = app.flashes('cart_error') %}{% for message in cartErrors %}<div class="error" role="alert">{{ message }}</div>{% endfor %}
<div class="page-heading"><div><p class="eyebrow">MỖI CUỐN SÁCH, MỘT THẾ GIỚI</p><h1>Khám phá sách</h1><p>Tìm một cuốn sách cho hành trình tiếp theo của bạn.</p></div><a class="button button-outline" href="{{ path('app_my_cart') }}">Xem giỏ hàng →</a></div>
{% for message in errors %}<div class="error" role="alert">{{ message }}</div>{% endfor %}
<form class="card catalog-filters" method="get" action="{{ path('app_catalog') }}">
<div class="search-field"><label for="q">Tìm sách hoặc tác giả</label><input id="q" name="q" value="{{ filters.q }}" maxlength="200" placeholder="Bạn muốn đọc gì hôm nay?"></div>
<div><label for="category">Loại sách</label><select id="category" name="category"><option value="">Tất cả loại sách</option>{% for category in categories %}<option value="{{ category.LOAI_SACH_MA_LOAI }}" {{ filters.category == category.LOAI_SACH_MA_LOAI ? 'selected' : '' }}>{{ category.LOAI_SACH_TEN_LOAI }}</option>{% endfor %}</select></div>
<div><label for="min">Giá từ (VNĐ)</label><input type="number" id="min" name="min" min="0" step="0.01" value="{{ filters.min }}" placeholder="0"></div>
<div><label for="max">Đến (VNĐ)</label><input type="number" id="max" name="max" min="0" step="0.01" value="{{ filters.max }}" placeholder="Không giới hạn"></div>
<div><label for="sort">Sắp xếp</label><select id="sort" name="sort"><option value="name" {{ filters.sort == 'name' ? 'selected' : '' }}>Tên A–Z</option><option value="price_asc" {{ filters.sort == 'price_asc' ? 'selected' : '' }}>Giá tăng dần</option><option value="price_desc" {{ filters.sort == 'price_desc' ? 'selected' : '' }}>Giá giảm dần</option></select></div>
<div class="filter-actions"><button class="button">Tìm sách</button><a href="{{ path('app_catalog') }}">Xóa bộ lọc</a></div>
</form>
<div class="section-heading"><p>{{ total }} cuốn sách · Trang {{ page }}/{{ pages }}</p></div>
<div class="book-grid">{% for book in books %}
<article class="card product-card"><div class="book-cover cover-{{ book.SACH_ID_SACH % 4 }}" aria-hidden="true"><span>NHÀ SÁCH NHÓM 04</span><strong>{{ book.SACH_TEN_SACH }}</strong><small>▤ &nbsp; {{ book.LOAI_SACH_TEN_LOAI }}</small></div><div class="product-info"><p class="eyebrow">{{ book.LOAI_SACH_TEN_LOAI }}</p><h2 title="{{ book.SACH_TEN_SACH }}">{{ book.SACH_TEN_SACH }}</h2><p class="book-author">{{ book.SACH_TAC_GIA|default('Chưa cập nhật tác giả') }}</p><strong class="book-price">{{ book.SACH_GIA_BAN is not null ? book.SACH_GIA_BAN|vnd : 'Chưa có giá' }}</strong><p class="stock">{{ book.SACH_SO_LUONG > 0 ? 'Còn ' ~ book.SACH_SO_LUONG ~ ' cuốn' : 'Hết hàng' }}</p>
{% if book.SACH_SO_LUONG > 0 and book.SACH_GIA_BAN is not null and book.SACH_GIA_BAN >= 0 %}<form class="add-book" action="{{ path('app_cart_modify') }}" method="post" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('cart_modify') }}"><input type="hidden" name="action" value="add"><input type="hidden" name="return_to" value="{{ path('app_catalog', app.request.query.all|filter((value, key) => key != 'cart_detail')) }}"><input type="hidden" name="book_id" value="{{ book.SACH_ID_SACH }}"><label class="sr-only" for="quantity-{{ book.SACH_ID_SACH }}">Số lượng {{ book.SACH_TEN_SACH }}</label><input id="quantity-{{ book.SACH_ID_SACH }}" name="quantity" type="number" min="1" max="{{ book.SACH_SO_LUONG }}" value="1" required><button class="button">Thêm vào giỏ</button></form>{% else %}<button class="button unavailable" disabled>Chưa thể đặt sách</button>{% endif %}<button type="button" class="quick-view" data-open-book="book-detail-{{ book.SACH_ID_SACH }}" aria-haspopup="dialog">Xem chi tiết sách</button></div>
<dialog class="book-dialog" id="book-detail-{{ book.SACH_ID_SACH }}" aria-labelledby="book-title-{{ book.SACH_ID_SACH }}"><button type="button" class="dialog-close" data-close-dialog aria-label="Đóng chi tiết sách">×</button>{% if app.request.query.get('cart_detail') == book.SACH_ID_SACH %}{% for message in cartErrors %}<div class="error" role="alert">{{ message }}</div>{% endfor %}{% endif %}<div class="book-dialog-content"><div class="book-cover cover-{{ book.SACH_ID_SACH % 4 }}" aria-hidden="true"><span>NHÀ SÁCH NHÓM 04</span><strong>{{ book.SACH_TEN_SACH }}</strong><small>▤ {{ book.LOAI_SACH_TEN_LOAI }}</small></div><div><p class="eyebrow">THÔNG TIN SÁCH</p><h2 id="book-title-{{ book.SACH_ID_SACH }}">{{ book.SACH_TEN_SACH }}</h2><dl><dt>Tác giả</dt><dd>{{ book.SACH_TAC_GIA ?: 'Chưa cập nhật' }}</dd><dt>Thể loại</dt><dd>{{ book.LOAI_SACH_TEN_LOAI ?: 'Chưa cập nhật' }}</dd><dt>Tình trạng</dt><dd>{{ book.SACH_SO_LUONG > 0 ? 'Còn ' ~ book.SACH_SO_LUONG ~ ' cuốn' : 'Hết hàng' }}</dd></dl><strong class="book-price">{{ book.SACH_GIA_BAN is not null ? book.SACH_GIA_BAN|vnd : 'Chưa có giá' }}</strong><p class="muted">Chọn số lượng bạn muốn mua. Nhà sách sẽ kiểm tra lại tồn kho khi gửi giỏ.</p>{% if book.SACH_SO_LUONG > 0 and book.SACH_GIA_BAN is not null and book.SACH_GIA_BAN >= 0 %}<form class="add-book dialog-add" action="{{ path('app_cart_modify') }}" method="post" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('cart_modify') }}"><input type="hidden" name="action" value="add"><input type="hidden" name="return_to" value="{{ path('app_catalog', app.request.query.all|merge({cart_detail: book.SACH_ID_SACH})) }}"><input type="hidden" name="book_id" value="{{ book.SACH_ID_SACH }}"><label class="sr-only" for="dialog-quantity-{{ book.SACH_ID_SACH }}">Số lượng {{ book.SACH_TEN_SACH }}</label><input id="dialog-quantity-{{ book.SACH_ID_SACH }}" type="number" name="quantity" min="1" max="{{ book.SACH_SO_LUONG }}" value="1" required><button class="button">Thêm vào giỏ</button></form>{% endif %}<button type="button" class="quick-view" data-close-dialog>Quay lại danh mục</button></div></div></dialog></article>
{% else %}<section class="card empty-state no-results"><h2>Chưa tìm thấy sách phù hợp</h2><p>Thử từ khóa khác hoặc điều chỉnh bộ lọc.</p><a href="{{ path('app_catalog') }}">Xem tất cả sách →</a></section>{% endfor %}</div>
{% if pages > 1 %}<nav class="pagination" aria-label="Phân trang sách">{% if page > 1 %}<a href="{{ path('app_catalog', filters|merge({page:page-1})) }}">← Trước</a>{% endif %}{% for number in 1..pages %}{% if number == 1 or number == pages or (number >= page-2 and number <= page+2) %}<a class="{{ number == page ? 'active' : '' }}" {% if number == page %}aria-current="page"{% endif %} href="{{ path('app_catalog', filters|merge({page:number})) }}">{{ number }}</a>{% endif %}{% endfor %}{% if page < pages %}<a href="{{ path('app_catalog', filters|merge({page:page+1})) }}">Sau →</a>{% endif %}</nav>{% endif %}
{% endblock %}
