{% extends 'account/layout.html.twig' %}

{% block title %}403 - Quyền truy cập bị từ chối · Nhà sách Nhóm 04{% endblock %}

{% block content %}
<div class="empty-state" style="padding: 56px 20px; max-width: 680px; margin: 0 auto; text-align: center;">
    <div style="width: 80px; height: 80px; margin: 0 auto 20px; border-radius: 50%; background: #fee2e2; color: #dc2626; display: grid; place-items: center; box-shadow: 0 8px 24px #dc262615;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
    </div>

    <div style="font-size: 4.8rem; font-weight: 850; line-height: 1; color: #dc2626; letter-spacing: -0.05em; margin-bottom: 12px;">
        403
    </div>

    <span class="status-pill status-rejected" style="margin-bottom: 18px; font-size: 0.82rem; padding: 6px 14px;">
        Truy cập bị từ chối
    </span>

    <h1 style="font-size: 1.85rem; margin: 14px 0 12px; color: var(--ink);">
        Bạn không có quyền truy cập trang này
    </h1>

    <p style="font-size: 0.96rem; color: var(--muted); line-height: 1.6; margin: 0 auto 28px; max-width: 520px;">
        {{ message|default('Bạn không có quyền truy cập vào chức năng hoặc khu vực này. Vui lòng kiểm tra lại quyền hạn tài khoản hoặc trạng thái giỏ hàng.') }}
    </p>

    <div style="background: #ffffff; border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 24px; text-align: left; margin: 0 auto 32px; box-shadow: var(--shadow); font-size: 0.88rem;">
        <strong style="display: block; color: var(--ink); margin-bottom: 8px;">💡 Một số lý do phổ biến:</strong>
        <ul style="margin: 0; padding-left: 20px; color: var(--muted); line-height: 1.7;">
            <li><strong>Giỏ hàng đã được xử lý:</strong> Chỉ có thể chỉnh sửa giỏ hàng khi đơn đang ở trạng thái <em>Chờ duyệt</em>. Nếu đơn đã được duyệt hoặc từ chối, bạn chỉ có thể xem lại chi tiết.</li>
            <li><strong>Chủ sở hữu đơn hàng:</strong> Mỗi khách hàng chỉ có thể xem và cập nhật giỏ hàng do chính mình tạo ra.</li>
            <li><strong>Phân quyền quản trị:</strong> Các trang quản lý hệ thống yêu cầu tài khoản <em>Quản trị viên (Admin)</em> để truy cập.</li>
        </ul>
    </div>

    <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a class="button" href="{{ path(app.user ? (is_granted('ROLE_ADMIN') ? 'app_admin_dashboard' : 'app_customer_home') : 'app_home') }}">
            ← Về trang chủ
        </a>
        {% if app.user and not is_granted('ROLE_ADMIN') %}
            <a class="button button-outline" href="{{ path('app_cart_history') }}">
                📋 Xem lịch sử giỏ hàng
            </a>
            <a class="button button-outline" href="{{ path('app_catalog') }}">
                ▤ Khám phá sách
            </a>
        {% elseif is_granted('ROLE_ADMIN') %}
            <a class="button button-outline" href="{{ path('app_admin_carts') }}">
                ▤ Quản lý giỏ hàng
            </a>
            <a class="button button-outline" href="{{ path('app_admin_dashboard') }}">
                ▦ Bảng điều khiển
            </a>
        {% else %}
            <a class="button button-outline" href="{{ path('app_login') }}">
                Đăng nhập tài khoản
            </a>
        {% endif %}
    </div>
</div>
{% endblock %}
