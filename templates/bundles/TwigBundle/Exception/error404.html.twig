{% extends 'account/layout.html.twig' %}

{% block title %}404 - Không tìm thấy trang · Nhà sách Nhóm 04{% endblock %}

{% block content %}
<div class="empty-state" style="padding: 48px 20px 64px; max-width: 720px; margin: 0 auto; text-align: center;">
    <div style="width: 88px; height: 88px; margin: 0 auto 20px; border-radius: 50%; background: #eff6ff; color: var(--blue); display: grid; place-items: center; box-shadow: 0 10px 28px #2563eb18;">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
            <path d="M6 6h10"/>
            <path d="M6 10h10"/>
            <path d="m14 17 3 3"/>
            <path d="m17 14-3 3"/>
        </svg>
    </div>

    <div style="font-size: 5rem; font-weight: 850; line-height: 1; color: var(--blue); letter-spacing: -0.05em; margin-bottom: 12px;">
        404
    </div>

    <span class="status-pill status-cancelled" style="margin-bottom: 18px; font-size: 0.82rem; padding: 6px 14px;">
        Trang không tồn tại
    </span>

    <h1 style="font-size: 1.9rem; margin: 14px 0 12px; color: var(--ink);">
        Ối! Cuốn sách hoặc trang bạn tìm không có ở đây
    </h1>

    <p style="font-size: 0.98rem; color: var(--muted); line-height: 1.6; margin: 0 auto 26px; max-width: 520px;">
        {{ message|default('Địa chỉ đường dẫn (URL) bạn vừa truy cập không tồn tại hoặc đã bị thay đổi.') }}
    </p>

    {# Direct search bar to find books easily #}
    <form action="{{ path('app_catalog') }}" method="get" role="search" style="display: flex; gap: 10px; max-width: 480px; margin: 0 auto 30px; justify-content: center;">
        <label class="sr-only" for="error-search-q">Tìm kiếm sách</label>
        <input id="error-search-q" type="search" name="q" placeholder="Tìm tên sách, tác giả..." style="margin: 0; min-height: 44px; flex: 1;">
        <button type="submit" class="button" style="white-space: nowrap;">
            🔍 Tìm sách
        </button>
    </form>

    <div style="background: #ffffff; border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 24px; text-align: left; margin: 0 auto 32px; box-shadow: var(--shadow); font-size: 0.88rem;">
        <strong style="display: block; color: var(--ink); margin-bottom: 8px;">💡 Bạn có thể thử:</strong>
        <ul style="margin: 0; padding-left: 20px; color: var(--muted); line-height: 1.7;">
            <li>Kiểm tra lại tính chính xác của thanh địa chỉ URL trên trình duyệt.</li>
            <li>Sử dụng ô tìm kiếm ở trên để tìm tựa sách, tác giả yêu thích trong kho sách Nhóm 04.</li>
            <li>Quay trở lại trang chủ hoặc duyệt toàn bộ danh mục sách hiện có.</li>
        </ul>
    </div>

    <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a class="button" href="{{ path(app.user ? (is_granted('ROLE_ADMIN') ? 'app_admin_dashboard' : 'app_customer_home') : 'app_home') }}">
            ← Về trang chủ
        </a>
        {% if not is_granted('ROLE_ADMIN') %}
            <a class="button button-outline" href="{{ path('app_catalog') }}">
                ▤ Khám phá danh mục sách
            </a>
            {% if app.user %}
                <a class="button button-outline" href="{{ path('app_cart_history') }}">
                    📋 Lịch sử giỏ hàng
                </a>
            {% endif %}
        {% else %}
            <a class="button button-outline" href="{{ path('app_admin_carts') }}">
                ▤ Quản lý giỏ hàng
            </a>
            <a class="button button-outline" href="{{ path('app_admin_dashboard') }}">
                ▦ Bảng điều khiển
            </a>
        {% endif %}
    </div>
</div>
{% endblock %}
