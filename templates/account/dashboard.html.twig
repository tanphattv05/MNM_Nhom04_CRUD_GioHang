{% extends 'account/layout.html.twig' %}
{% block content %}
{% if admin %}
<div class="page-heading"><div><p class="eyebrow">TỔNG QUAN</p><h1>{{ current == 'app_admin_carts' ? 'Quản lý giỏ hàng' : 'Dashboard quản trị' }}</h1><p>Chào {{ app.user.profile.QTV_HO_TEN|default(app.user.id) }}, chúc bạn một ngày làm việc hiệu quả.</p></div><span class="status-pill">Khu vực Admin</span></div>
<div class="dashboard-overview"><section class="card dashboard-stat"><p class="eyebrow">CẦN XỬ LÝ</p><h2>Giỏ hàng chờ duyệt</h2><strong class="stat-number">{{ pending_count }}</strong><p>Yêu cầu đang chờ bạn kiểm tra và xác nhận.</p><a class="button" href="{{ path('app_admin_carts', {status:'Chờ duyệt'}) }}">Xem giỏ chờ duyệt →</a></section><section class="card"><p class="eyebrow">QUY TRÌNH QUẢN TRỊ</p><h2>Mỗi yêu cầu, một trải nghiệm tốt</h2><div class="admin-steps"><div class="admin-step"><div><strong>Kiểm tra giỏ hàng</strong>Xem sách, số lượng và ghi chú khách hàng.</div></div><div class="admin-step"><div><strong>Duyệt hoặc từ chối</strong>Kiểm tra tồn kho; nhập lý do khi từ chối.</div></div><div class="admin-step"><div><strong>Quản lý lịch sử</strong>Tra cứu trạng thái và các yêu cầu đã xử lý.</div></div></div><a class="text-link" href="{{ path('app_admin_carts') }}">Tất cả giỏ hàng →</a></section></div>
{% elseif current == 'app_customer_home' %}
<section class="hero"><div class="hero-copy"><p class="eyebrow">KHÔNG GIAN DÀNH CHO NGƯỜI YÊU SÁCH</p><h1>Mở một trang sách.<br>Mở cả thế giới.</h1><p>Xin chào <strong>{{ app.user.profile.THANH_VIEN_HO_TEN }}</strong>. Chào mừng bạn trở lại với Nhà sách Nhóm 04.</p>{% include 'components/book-search.html.twig' %}<a class="button button-outline" href="{{ path('app_catalog') }}">Khám phá sách <span aria-hidden="true">→</span></a></div><div class="book-illustration" aria-hidden="true"><span class="book book-one">KHÁM PHÁ</span><span class="book book-two">TRI THỨC</span><span class="book book-three">CẢM HỨNG</span><div class="book-shelf"></div><span class="art-caption">YOUR NEXT CHAPTER</span></div></section>
<div class="section-heading"><h2>Góc nhỏ của bạn</h2><p>Mọi thứ bạn cần, trong một không gian.</p></div>
<div class="feature-grid"><a class="card feature-card" href="{{ path('app_catalog') }}"><span class="feature-icon" aria-hidden="true">▥</span><h3>Danh mục sách</h3><p>Tìm kiếm sách theo tác giả, thể loại và mức giá.</p><span class="text-link">Xem thông tin →</span></a><a class="card feature-card" href="{{ path('app_my_cart') }}"><span class="feature-icon" aria-hidden="true">▤</span><h3>Giỏ hàng của tôi</h3><p>Kiểm tra sách đã chọn và gửi yêu cầu nhà sách duyệt.</p><span class="text-link">Xem thông tin →</span></a><a class="card feature-card" href="{{ path('app_profile') }}"><span class="feature-icon" aria-hidden="true">◎</span><h3>Hồ sơ cá nhân</h3><p>Cập nhật thông tin liên hệ và quản lý tài khoản của bạn.</p><span class="text-link">Quản lý hồ sơ →</span></a></div>
{% else %}
<div class="page-heading"><div><p class="eyebrow">NHÀ SÁCH NHÓM 04</p><h1>{{ current == 'app_catalog' ? 'Danh mục sách' : 'Giỏ hàng của tôi' }}</h1></div></div><section class="card empty-state"><span class="feature-icon" aria-hidden="true">▤</span><h2>Hẹn bạn ở chương tiếp theo</h2><p>{{ section }}. Chức năng chọn sách và thao tác giỏ hàng hiện chưa mở.</p><a class="button" href="{{ path('app_customer_home') }}">Về trang chủ</a></section>
{% endif %}
{% endblock %}
