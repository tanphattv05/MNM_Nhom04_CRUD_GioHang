{% extends 'account/layout.html.twig' %}
{% block title %}Đăng nhập · Nhà sách Nhóm 04{% endblock %}
{% block content %}<div class="auth-grid"><aside class="auth-intro"><p class="eyebrow">CHÀO MỪNG BẠN TRỞ LẠI</p><h1>Mỗi trang sách,<br>một chân trời mới.</h1><p>Một không gian riêng để quản lý tài khoản và bắt đầu hành trình cùng những trang sách.</p><div class="intro-note"><span class="feature-icon" aria-hidden="true">▤</span><span>Đọc hôm nay.<br><strong>Khám phá ngày mai.</strong></span></div></aside>
<section class="card auth-card"><span class="status-pill">Tài khoản nhà sách</span><h2>Đăng nhập</h2><p class="muted">Nhập thông tin tài khoản của bạn để tiếp tục.</p>
{% if error %}<div class="error" role="alert">Tên đăng nhập hoặc mật khẩu không đúng, hoặc chưa thể đăng nhập. Vui lòng kiểm tra và thử lại sau.</div>{% endif %}
<form action="{{ path('app_login') }}" method="post" data-turbo="false"><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
<label for="login">Tên đăng nhập</label><input id="login" name="_username" type="text" autocomplete="username" maxlength="150" placeholder="Tên đăng nhập của bạn" required>
<label for="password">Mật khẩu</label><div class="password-row"><input id="password" name="_password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required><button type="button" data-toggle-password="password" aria-pressed="false">Hiện</button></div>
<button class="primary">Đăng nhập</button></form>
<p class="auth-bottom">Chưa có tài khoản? <a href="{{ path('app_register') }}">Đăng ký ngay</a></p></section></div>{% endblock %}
