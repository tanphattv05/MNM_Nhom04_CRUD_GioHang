{% extends 'base.html.twig' %}
{% set current = app.request.attributes.get('_route') %}
{% set is_admin = is_granted('ROLE_ADMIN') %}
{% block title %}Nhà sách Nhóm 04{% endblock %}
{% block stylesheets %}
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="{{ asset('styles/account.css') }}" data-turbo-track="reload">
{% endblock %}
{% block body %}
<div class="site-shell">
<a class="skip-link" href="#main-content">Chuyển đến nội dung chính</a>
<header class="site-header {{ is_admin ? 'is-admin' : '' }}">
<div class="header-container">
<div class="header-brand-search">
    <a class="brand" href="{{ path(app.user ? (is_admin ? 'app_admin_dashboard' : 'app_customer_home') : 'app_home') }}"><span class="brand-mark" aria-hidden="true">▤</span><strong class="brand-name">Nhóm 04</strong></a>
{% if not is_admin %}
{% include 'components/book-search.html.twig' %}
{% endif %}
</div>
{% if not is_admin %}
<nav class="customer-nav" aria-label="Menu khách hàng">
    {% for route, label in {'app_customer_home':'Trang chủ','app_catalog':'Danh mục','app_my_cart':'Giỏ hàng','app_cart_history':'Lịch sử'} %}
    {% set active = current == route or (route == 'app_profile' and current == 'app_password') or (route == 'app_cart_history' and current in ['app_cart_detail', 'app_cart_edit']) or (route == 'app_my_cart' and current == 'app_cart_checkout') %}
    <a class="{{ active ? 'active' : '' }}" {% if active %}aria-current="page"{% endif %} href="{{ path(route) }}">{{ label }}</a>
    {% endfor %}
</nav>
{% endif %}
    <div class="header-actions">{% if app.user %}
    <details class="account-menu">
        <summary class="account-trigger" aria-controls="account-dropdown"><span class="account-avatar" aria-hidden="true"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></span><span class="account-name">{{ is_admin ? app.user.profile.QTV_HO_TEN : app.user.profile.THANH_VIEN_HO_TEN }}</span><span class="account-chevron" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m6 9 6 6 6-6"/></svg></span></summary>
        <nav class="account-dropdown" id="account-dropdown" aria-label="Menu tài khoản">
            {% if not is_admin %}<a href="{{ path('app_profile') }}" {% if current == 'app_profile' %}aria-current="page"{% endif %}>Thông tin cá nhân</a><a href="{{ path('app_password') }}" {% if current == 'app_password' %}aria-current="page"{% endif %}>Đổi mật khẩu</a>{% endif %}
            {% include 'account/_logout.html.twig' %}
        </nav>
    </details>
    {% else %}<a href="{{ path('app_login') }}">Đăng nhập</a><a class="button button-small" href="{{ path('app_register') }}">Đăng ký</a>{% endif %}</div>
</div>
</header>
<div class="page-frame {{ is_admin ? 'admin-frame' : '' }}">
{% if is_admin %}
<aside class="admin-sidebar" aria-label="Quản trị">
    <p class="eyebrow">KHÔNG GIAN QUẢN TRỊ</p><h2>Quản lý nhà sách</h2>
    <nav class="sidebar-nav" aria-label="Menu Admin"><a class="{{ current == 'app_admin_dashboard' ? 'active' : '' }}" href="{{ path('app_admin_dashboard') }}">▦ <span>Dashboard</span></a><a class="{{ current in ['app_admin_carts', 'app_admin_cart_detail'] ? 'active' : '' }}" href="{{ path('app_admin_carts') }}">▤ <span>Quản lý giỏ hàng</span></a></nav>
    <div class="admin-identity"><span class="avatar" aria-hidden="true">QT</span><div><strong>{{ app.user.profile.QTV_HO_TEN|default(app.user.id) }}</strong><small>{{ app.user.id }}</small></div></div>
    {% include 'account/_logout.html.twig' %}
</aside>
{% endif %}
<main id="main-content" class="main-content">{% for message in app.flashes('success') %}<div class="notice" role="status">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="notice" role="alert">{{ message }}</div>{% endfor %}{% block content %}{% endblock %}</main>
</div>
<footer class="site-footer"><div><strong>Nhà sách Nhóm 04<span class="brand-dot">.</span></strong><p>Nuôi dưỡng thói quen đọc, mở rộng những chân trời.</p></div><div class="footer-links"><a href="{{ path(is_admin ? 'app_admin_dashboard' : 'app_home') }}">{{ is_admin ? 'Tổng quan quản trị' : 'Trang chủ' }}</a>{% if not is_admin %}<a href="{{ path('app_catalog') }}">Khám phá sách</a>{% endif %}<span>Đọc sách · Kết nối · Khám phá</span></div></footer>
</div>
{% endblock %}
