{% extends 'base.html.twig' %}
{% set current = app.request.attributes.get('_route') %}
{% set is_admin = is_granted('ROLE_ADMIN') %}
{% block title %}Nhà sách Nhóm 04{% endblock %}
{% block stylesheets %}
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="{{ asset('styles/account.css') }}" data-turbo-track="reload">
{% endblock %}
{% block body %}
<div class="site-shell">
<header class="site-header">
    <a class="brand" href="{{ path(app.user ? (is_admin ? 'app_admin_dashboard' : 'app_customer_home') : 'app_home') }}"><span class="brand-mark" aria-hidden="true">▤</span><span>NHÀ SÁCH<strong>Nhóm 04<span class="brand-dot">.</span></strong></span></a>
{% if not is_admin %}
<nav class="customer-nav" aria-label="Menu khách hàng">
    {% for route, label in {'app_customer_home':'Trang chủ','app_catalog':'Danh mục sách','app_my_cart':'Giỏ hàng','app_cart_history':'Lịch sử giỏ','app_profile':'Hồ sơ'} %}
    {% set active = current == route or (route == 'app_profile' and current == 'app_password') or (route == 'app_cart_history' and current == 'app_cart_detail') %}
    <a class="{{ active ? 'active' : '' }}" {% if active %}aria-current="page"{% endif %} href="{{ path(route) }}">{{ label }}</a>
    {% endfor %}
</nav>
{% endif %}
    <div class="header-actions">{% if app.user %}<span class="account-badge">Xin chào, {{ is_admin ? app.user.profile.QTV_HO_TEN : app.user.profile.THANH_VIEN_HO_TEN }}</span>{% include 'account/_logout.html.twig' %}{% else %}<a href="{{ path('app_login') }}">Đăng nhập</a><a class="button button-small" href="{{ path('app_register') }}">Đăng ký</a>{% endif %}</div>
</header>
<div class="page-frame {{ is_admin ? 'admin-frame' : '' }}">
{% if is_admin %}
<aside class="admin-sidebar" aria-label="Quản trị">
    <p class="eyebrow">KHÔNG GIAN QUẢN TRỊ</p><h2>Quản lý nhà sách</h2>
    <nav class="sidebar-nav" aria-label="Menu Admin"><a class="{{ current == 'app_admin_dashboard' ? 'active' : '' }}" href="{{ path('app_admin_dashboard') }}">▦ <span>Dashboard</span></a><a class="{{ current in ['app_admin_carts', 'app_admin_cart_detail'] ? 'active' : '' }}" href="{{ path('app_admin_carts') }}">▤ <span>Quản lý giỏ hàng</span></a></nav>
    <div class="admin-identity"><span class="avatar" aria-hidden="true">QT</span><div><strong>{{ app.user.profile.QTV_HO_TEN|default(app.user.id) }}</strong><small>{{ app.user.id }}</small></div></div>
    {% include 'account/_logout.html.twig' %}
</aside>
{% endif %}
<main id="main-content" class="main-content">{% for message in app.flashes('success') %}<div class="notice" role="status">{{ message }}</div>{% endfor %}{% block content %}{% endblock %}</main>
</div>
<footer class="site-footer"><div><strong>Nhà sách Nhóm 04</strong><p>Nuôi dưỡng thói quen đọc, mở rộng những chân trời.</p></div><span>Đọc sách · Kết nối · Khám phá</span></footer>
</div>
{% endblock %}
