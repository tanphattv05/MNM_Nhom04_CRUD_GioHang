{% extends 'account/layout.html.twig' %}
{% block title %}Giỏ hàng của tôi · Nhà sách Nhóm 04{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('styles/shop.css') }}">{% endblock %}
{% block content %}
<div class="page-heading"><div><p class="eyebrow">NHỮNG TRANG SÁCH BẠN ĐÃ CHỌN</p><h1>Giỏ hàng của tôi</h1><p>Kiểm tra số lượng trước khi gửi yêu cầu duyệt.</p></div><a href="{{ path('app_catalog') }}">← Tiếp tục chọn sách</a></div>
{% for message in app.flashes('cart_error') %}<div class="error" role="alert">{{ message }}</div>{% endfor %}{% if error %}<div class="error" role="alert">{{ error }}</div>{% endif %}
{% if lines is empty %}<section class="card empty-state"><span class="feature-icon" aria-hidden="true">▤</span><h2>Giỏ hàng của bạn đang trống</h2><p>Chọn những cuốn sách bạn yêu thích để bắt đầu.</p><a class="button" href="{{ path('app_catalog') }}">Khám phá sách →</a></section>
{% else %}<div class="cart-layout"><section class="cart-lines" aria-label="Sách đang chọn">{% for line in lines %}<article class="card cart-line"><div class="cart-book-icon" aria-hidden="true">▤</div><div class="cart-book-info"><h2>{{ line.book ? line.book.SACH_TEN_SACH : 'Sách không còn tồn tại' }}</h2><p>{{ line.book ? line.book.SACH_TAC_GIA : '' }}</p><p>Đơn giá: {{ (line.price / 100)|number_format(0, ',', '.') }} ₫ · Tồn kho: {{ line.book ? line.book.SACH_SO_LUONG : 0 }}</p>{% if line.error %}<p class="line-error" role="alert">{{ line.error }}</p>{% endif %}
<form class="cart-controls" action="{{ path('app_cart_modify') }}" method="post" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('cart_modify') }}"><input type="hidden" name="book_id" value="{{ line.id }}"><label class="sr-only" for="cart-quantity-{{ line.id }}">Số lượng sách {{ line.id }}</label><input id="cart-quantity-{{ line.id }}" type="number" name="quantity" min="1" max="{{ max(1, line.book ? line.book.SACH_SO_LUONG : 1) }}" value="{{ line.quantity }}" required><button class="button button-outline" name="action" value="update">Cập nhật</button><button class="remove-book" name="action" value="remove" formnovalidate>Bỏ sách</button></form></div><strong class="line-total">{{ (line.subtotal / 100)|number_format(0, ',', '.') }} ₫</strong></article>{% endfor %}</section>
<aside class="card cart-summary"><p class="eyebrow">YÊU CẦU CỦA BẠN</p><h2>Tóm tắt giỏ hàng</h2><div class="summary-row"><span>Đầu sách</span><strong>{{ lines|length }}</strong></div><div class="summary-row grand-total"><span>Tổng tiền</span><strong>{{ (total / 100)|number_format(0, ',', '.') }} ₫</strong></div><form action="{{ path('app_cart_submit') }}" method="post" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('cart_submit') }}"><input type="hidden" name="nonce" value="{{ nonce }}"><label for="note">Ghi chú (không bắt buộc)</label><textarea id="note" name="note" maxlength="255" rows="3" placeholder="Lời nhắn cho nhà sách…">{{ note }}</textarea><button class="primary" {{ not valid ? 'disabled' : '' }}>Gửi giỏ hàng</button></form><p class="checkout-note">Sau khi gửi, giỏ hàng ở trạng thái <strong>Chờ duyệt</strong>. Tồn kho chưa bị trừ và giá được kiểm tra lại theo dữ liệu hiện tại.</p></aside></div>{% endif %}
{% endblock %}
