{% extends 'base.html.twig' %}
{% block title %}Thêm giỏ hàng | Symfony{% endblock %}
{% block stylesheets %}
<style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Arial, sans-serif; background: #f3f6fb; color: #1e293b; }
    .container { max-width: 680px; margin: 55px auto; padding: 0 16px; }
    .card { background: white; border-radius: 15px; padding: 34px; box-shadow: 0 10px 35px #1e293b17; }
    h1 { font-size: 27px; margin: 0 0 8px; }
    p { color: #64748b; margin: 0 0 26px; }
    label { display: block; font-weight: 600; margin: 18px 0 8px; }
    select, textarea { width: 100%; font: inherit; padding: 12px; border: 1px solid #cbd5e1; border-radius: 9px; background: #fff; }
    textarea { resize: vertical; min-height: 100px; }
    button { margin-top: 22px; background: #2563eb; color: #fff; font: inherit; font-weight: 600; border: 0; border-radius: 9px; padding: 12px 22px; cursor: pointer; }
    button:hover { background: #1d4ed8; }
    .notice { padding: 12px 15px; border-radius: 8px; margin-bottom: 14px; }
    .ok { background: #dcfce7; color: #166534; }
    .error { background: #fee2e2; color: #991b1b; }
    .help { color: #64748b; font-size: 13px; margin-top: 7px; }
</style>
{% endblock %}
{% block body %}
<div class="container"><div class="card">
    <h1>Thêm giỏ hàng</h1>
    <p>Tạo bản ghi mới trong bảng GIO_HANG của BanSachDB.</p>
    {% for message in app.flashes('success') %}<div class="notice ok">{{ message }}</div>{% endfor %}
    {% for error in errors %}<div class="notice error">{{ error }}</div>{% endfor %}
    <form method="post" action="{{ path('app_gio_hang_new') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('create_gio_hang') }}">
        <label for="admin">Quản trị viên <span aria-hidden="true">*</span></label>
        <select id="admin" name="admin" required>
            <option value="">-- Chọn quản trị viên --</option>
            {% for username in admins %}
                <option value="{{ username }}" {{ selectedAdmin == username ? 'selected' : '' }}>{{ username }}</option>
            {% endfor %}
        </select>
        <label for="status">Trạng thái <span aria-hidden="true">*</span></label>
        <select id="status" name="status" required>
            {% for item in statuses %}
                <option value="{{ item }}" {{ selectedStatus == item ? 'selected' : '' }}>{{ item }}</option>
            {% endfor %}
        </select>
        <label for="note">Ghi chú</label>
        <textarea id="note" name="note" maxlength="255" placeholder="Nhập ghi chú (nếu có)">{{ note }}</textarea>
        <div class="help">Mã giỏ hàng và thời gian tạo được sinh tự động.</div>
        <button type="submit">Thêm giỏ hàng</button>
    </form>
</div></div>
{% endblock %}
